# Copy to backend/.env for local runs; set the same names in Render. Never commit .env.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Public HTTPS base URL of this backend (ngrok or Render), no trailing slash
PUBLIC_BASE_URL=https://your-backend.onrender.com
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
